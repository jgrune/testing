<?xml version="1.0" encoding="utf-8"?>
<!-- TV launcher banner (320dp x 180dp) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#0D0D1A"
                android:endColor="#1A2A4A"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:left="40dp"
        android:top="40dp"
        android:right="40dp"
        android:bottom="40dp">
        <!-- App icon centered in banner -->
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
